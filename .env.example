# Copy this file to ".env" (same folder) and fill in the values.
# All values here are public by design; never put a secret / service_role
# key (Supabase) or a secret sk_… key (RevenueCat) in this file.

# Supabase → Project Settings → API Keys (see docs/SETUP-BACKEND.md).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# RevenueCat → Project → API keys → your App Store app's public key
# (starts with appl_). See docs/SETUP-PAYMENTS.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Later, for Android (starts with goog_).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional: RevenueCat Test Store key (starts with test_) to try purchases
# in Expo Go. Leave empty for App Store builds.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# PostHog → Project settings → Project API key (starts with phc_). Public by
# design. Analytics only runs for people who say yes. See docs/SETUP-ANALYTICS.md.
EXPO_PUBLIC_POSTHOG_KEY=
# EU cloud (keep as is unless your PostHog project is in the US).
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
